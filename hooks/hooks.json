{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "(?i)\\b(commit|commits|committing)\\b",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/smart-commit-trigger.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre-commit-check.sh"
          }
        ]
      }
    ]
  }
}
